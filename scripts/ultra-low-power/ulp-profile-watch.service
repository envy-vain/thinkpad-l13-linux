[Unit]
Description=Turn ultra low power mode off when the power profile changes to Balanced/Performance
PartOf=graphical-session.target
After=plasma-plasmashell.service

[Service]
ExecStartPre=/usr/local/bin/ultra-low-power heal
ExecStart=/usr/local/bin/ultra-low-power watch
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
